FROM node:22-alpine
RUN corepack enable && corepack prepare pnpm@10.28.1 --activate
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY patches ./patches
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/i18n/package.json ./packages/i18n/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

ENV HUSKY=0
RUN pnpm install --frozen-lockfile

# Config files baked into the image (rebuilt when they change via --build)
COPY apps/api/tsconfig.json apps/api/tsconfig.build.json apps/api/nest-cli.json apps/api/mikro-orm.config.ts ./apps/api/
COPY packages/shared-types/tsconfig.json ./packages/shared-types/
COPY packages/shared-types/src ./packages/shared-types/src
COPY packages/typescript-config ./packages/typescript-config

# Build shared-types so api can resolve workspace package at runtime
RUN pnpm --filter @mtct/shared-types build

RUN chown -R 1000:1000 /app/apps /app/packages

# Source for apps/api is provided via volume mounts in docker-compose.dev.yml.
# Keep shared-types' dist fresh on src edits by running tsc --watch alongside the api.
CMD ["sh", "-c", "pnpm --filter @mtct/shared-types build:watch & pnpm run dev:api"]
