{
    "name": "more-than-control-tower",
    "version": "0.0.1",
    "private": true,
    "license": "UNLICENSED",
    "packageManager": "pnpm@10.28.1",
    "scripts": {
        "prepare": "husky",
        "build:shared-types": "pnpm --filter @mtct/shared-types build",
        "build:api": "pnpm --filter @mtct/api build",
        "build:web": "pnpm --filter @mtct/web build",
        "dev:api": "pnpm --filter @mtct/api dev",
        "dev:web": "pnpm --filter @mtct/web dev",
        "docker:dev": "bash scripts/dev.sh",
        "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
        "docker:dev:bootstrap": "echo 'Waiting for API on :3000...' && until curl -fs http://localhost:3000/api-json >/dev/null 2>&1; do sleep 1; done && echo 'API ready, syncing api-client...' && pnpm sync:api-client",
        "docker:build": "docker compose build",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "test:api": "pnpm --filter @mtct/api test",
        "test:api:integration": "DB_PORT=5433 pnpm --filter @mtct/api test:integration",
        "test:db:up": "bash scripts/test-db.sh",
        "test:db:down": "bash scripts/test-db.sh --down",
        "generate": "pnpm --filter @mtct/api-client generate && pnpm --filter @mtct/web generate",
        "lint": "pnpm run generate && pnpm -r --parallel run lint",
        "check-types": "pnpm run generate && pnpm -r --parallel run check-types",
        "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json}\" --no-error-on-unmatched-pattern",
        "format:check": "prettier --check .",
        "export:openapi": "pnpm --filter @mtct/api-client export:openapi",
        "generate:api-client": "pnpm --filter @mtct/api-client generate",
        "sync:api-client": "pnpm --filter @mtct/api-client sync",
        "migration:create": "pnpm --filter @mtct/api migration:create",
        "migration:up": "pnpm --filter @mtct/api migration:up",
        "migration:down": "pnpm --filter @mtct/api migration:down",
        "seed": "pnpm --filter @mtct/api seed",
        "cli": "pnpm --filter @mtct/api cli"
    },
    "devDependencies": {
        "eslint": "9.18.0",
        "husky": "9.1.7",
        "lint-staged": "16.4.0",
        "prettier": "3.4.2",
        "prettier-plugin-tailwindcss": "0.7.2",
        "typescript": "6.0.2"
    },
    "pnpm": {
        "overrides": {
            "typescript": "6.0.2"
        },
        "patchedDependencies": {
            "@nestjs/swagger@11.2.6": "patches/@nestjs__swagger@11.2.6.patch"
        }
    }
}
